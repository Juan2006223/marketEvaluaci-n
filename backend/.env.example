# ==============================================================================
# Backend Django - Marketplace CINNDET UPN - Variables de Entorno
# Copia este archivo como 'backend/.env'
# ==============================================================================

# Entorno de ejecución: True para desarrollo local, False para producción
DEBUG=True

# Clave secreta:
# En desarrollo (DEBUG=True): Puede usar el valor por defecto.
# En producción (DEBUG=False): OBLIGATORIO definir una cadena única de al menos 32 caracteres (sin 'django-insecure').
# Genere una clave local única; en producción es obligatoria y debe tener 32+ caracteres.
SECRET_KEY=

# Hosts permitidos (separados por coma):
# En producción (DEBUG=False): Dominios/IPs explícitos (el comodín '*' está estrictamente prohibido).
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Configuración CORS:
# En desarrollo (DEBUG=True): CORS_ALLOW_ALL=True permite acceso local.
# En producción (DEBUG=False): CORS_ALLOW_ALL DEBE ser False y CORS_ALLOWED_ORIGINS exige orígenes con 'https://' explícitos.
CORS_ALLOW_ALL=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Base de Datos:
# Desarrollo local (DEBUG=True): Deja vacío o comentado para usar SQLite (backend/db.sqlite3).
# Producción (DEBUG=False): OBLIGATORIO proveer DATABASE_URL con esquema 'postgresql://' o 'postgres://'.
# Ejemplo producción: DATABASE_URL=postgresql://usuario_upn:clave_segura@db.upn.edu.co:5432/marketplace_cinndet
DATABASE_URL=

# Superusuario Inicial para comando seed_db:
# Nota: La contraseña NO tiene valor por defecto por seguridad; debe definirse explícitamente o por terminal interactiva.
SEED_ADMIN_USERNAME=admin@upn.edu.co
SEED_ADMIN_EMAIL=admin@upn.edu.co
SEED_ADMIN_PASSWORD=
