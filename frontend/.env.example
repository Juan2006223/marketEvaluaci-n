# URL base del backend Django REST Framework (con barra diagonal final)
VITE_API_URL=http://localhost:8000/api/

# Client ID OAuth web de Google (no es secreto; termina en .apps.googleusercontent.com)
VITE_GOOGLE_CLIENT_ID=
